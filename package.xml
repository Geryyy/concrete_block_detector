<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>concrete_block_detector</name>
  <version>0.1.0</version>
  <description>Point-cloud concrete-block discovery node.</description>
  <maintainer email="maintainers@example.com">Concrete Block Stack</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>point_cloud_transport</depend>
  <depend>concrete_block_world_model_interfaces</depend>
  <depend>libpcl-all</depend>
  <exec_depend>cloudini_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
